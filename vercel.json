{
    "version": 2,
    "outputDirectory": "public",
    "builds": [
        { "src": "api/index.php", "use": "vercel-php@0.7.4" }
    ],
    "routes": [
        { "handle": "filesystem" },
        { "src": "/build/(.*)", "dest": "/build/$1" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "LOG_CHANNEL": "stderr",
        "CACHE_STORE": "array",
        "SESSION_DRIVER": "cookie",
        "QUEUE_CONNECTION": "sync"
    }
}